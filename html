      a {
        text-decoration: none;
      }

      .page-shell {
        min-height: 100vh;
        padding: 18px 14px 42px;
      }

      .profile-card {
        width: min(100%, 480px);
        margin: 0 auto;
      }

      .photo-frame {
        position: relative;
        background: rgba(255, 255, 255, 0.4);
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(28, 30, 40, 0.08);
        border: 1px solid rgba(214, 214, 214, 0.6);
