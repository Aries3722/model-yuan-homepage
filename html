            href="https://x.com/"
            target="_blank"
            rel="noreferrer noopener"
            class="social-link"
            aria-label="X"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.9 2h3.5l-7.63 8.72L23.1 22h-6.9l-5.4-7.72L4.3 22H.8l8.16-9.32L.7 2h7.08l4.88 7.12L18.9 2Zm-1.2 18h1.92L7.12 3.9H5.08L17.7 20Z"/>
            </svg>
          </a>
        </nav>

        <section class="info-box" aria-label="Profile information">
          <div class="info-header">
            <h1>Aoi Sora</h1>
          </div>
          <div class="info-grid">
            <div class="info-row">
              <div class="info-label">Birthday</div>
              <div class="info-value">2000 / 05 / 18</div>
            </div>
            <div class="info-row">
              <div class="info-label">Blood Type</div>
              <div class="info-value">A</div>
            </div>
            <div class="info-row">
              <div class="info-label">MBTI</div>
              <div class="info-value">ENFP</div>
            </div>
            <div class="info-row">
              <div class="info-label">Hobby</div>
              <div class="info-value">Photography, café hopping, yoga</div>
            </div>
            <div class="info-row" style="grid-column: 1 / -1;">
              <div class="info-label">Favorite</div>
              <div class="info-value">Soft jazz, fresh flowers, minimal design, sunsets</div>
            </div>
          </div>
        </section>

