            </svg>
          </a>
          <a
            href="https://mixch.tv/"
            target="_blank"
            rel="noreferrer noopener"
            class="social-link"
            aria-label="MixChannel"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 12 2.5Zm3.15 13.73a.93.93 0 0 1-1.31.31l-1.96-1.31a.6.6 0 0 0-.82.08l-.32.35a1.14 1.14 0 0 1-1.62.08l-1.18-1.02a.76.76 0 0 1-.2-1.08l.29-.45a.9.9 0 0 1 1.2-.2l1.5 1.05a.73.73 0 0 0 1-.12l.82-.9a1.14 1.14 0 0 1 1.56-.12l1.08 1a.72.72 0 0 1 .2 1.04Zm-2.35-7.15a1.08 1.08 0 1 1-1.08-1.08 1.08 1.08 0 0 1 1.08 1.08Z"/>
