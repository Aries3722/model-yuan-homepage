        border-radius: 28px;
      }

      .photo-frame .swiper-slide {
        background: #eee;
      }

      .swiper-pagination {
        position: relative !important;
        margin-top: 14px;
      }

      .swiper-pagination-bullet {
        width: 9px;
        height: 9px;
        background: rgba(110, 118, 124, 0.25);
        opacity: 1;
        transition: all 0.25s ease;
      }

      .swiper-pagination-bullet-active {
        width: 22px;
        border-radius: 999px;
        background: var(--sky-strong);
      }

      .social-links {
        margin-top: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
      }

      .social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.7);
        color: var(--ink);
        border: 1px solid var(--line);
        box-shadow: 0 8px 18px rgba(17, 24, 39, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      }

      .social-link:hover,
      .social-link:focus-visible {
        transform: translateY(-2px);
        border-color: rgba(142, 205, 245, 0.9);
        box-shadow: 0 12px 24px rgba(142, 205, 245, 0.18);
      }

      .social-link svg {
        width: 21px;
        height: 21px;
      }

      .info-box {
        margin-top: 24px;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(216, 220, 223, 0.9);
        border-radius: 24px;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
        overflow: hidden;
      }

      .info-header {
        padding: 18px 20px 8px;
      }

      .info-header h1 {
        margin: 0;
        font-size: clamp(1.65rem, 4vw, 2.1rem);
        font-weight: 700;
        letter-spacing: -0.04em;
      }

      .info-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0;
        padding: 0 20px 18px;
      }

      .info-row {
        display: flex;
        gap: 12px;
        padding: 12px 0;
        border-top: 1px solid var(--line);
      }

      .info-row:first-child {
        border-top: none;
      }

      .info-label {
        min-width: 100px;
        color: var(--muted);
        font-size: 0.82rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .info-value {
        flex: 1;
        font-weight: 500;
        color: var(--ink);
      }

      .events-wrap {
        margin-top: 30px;
      }

      .events-header {
        margin: 0 0 14px;
        font-size: clamp(1.15rem, 4vw, 1.5rem);
        font-weight: 700;
        letter-spacing: -0.03em;
      }

      .event-list {
        display: grid;
        gap: 12px;
      }

      .event-card {
        display: block;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 14px 16px;
        box-shadow: 0 10px 22px rgba(15, 23, 42, 0.03);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      }

      .event-card:hover,
      .event-card:focus-visible {
        transform: translateY(-2px);
        border-color: rgba(142, 205, 245, 0.75);
        box-shadow: 0 14px 28px rgba(142, 205, 245, 0.12);
      }

      .event-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .event-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--ink);
      }

      .event-tag {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 76px;
        padding: 6px 9px;
        border-radius: 999px;
        background: rgba(191, 227, 255, 0.7);
        color: #2a4c67;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .event-meta {
        margin-top: 7px;
        color: var(--muted);
        font-size: 0.8rem;
      }

      @media (min-width: 640px) {
        .page-shell {
          padding-top: 28px;
        }

        .profile-card {
          width: min(100%, 560px);
        }

        .photo-frame {
          border-radius: 34px;
        }

        .social-links {
          gap: 18px;
        }

        .info-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 0 10px;
        }

        .info-row {
          align-items: flex-start;
        }
      }

      @media (min-width: 768px) {
        .profile-card {
          width: min(100%, 760px);
        }

        .hero-wrap {
          max-width: 540px;
          margin: 0 auto;
        }

        .info-box {
          margin-top: 28px;
