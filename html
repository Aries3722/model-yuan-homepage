          <h2 class="events-header">Participated Events</h2>
          <div class="event-list">
            <a
              class="event-card"
              href="https://example.com/events/spring-fashion-show"
              target="_blank"
              rel="noreferrer noopener"
            >
              <div class="event-topline">
                <h3 class="event-title">Spring Fashion Show</h3>
                <span class="event-tag">2025</span>
              </div>
              <div class="event-meta">Tokyo · Featured runway model</div>
            </a>

            <a
              class="event-card"
              href="https://example.com/events/summer-photo-festival"
              target="_blank"
              rel="noreferrer noopener"
            >
              <div class="event-topline">
                <h3 class="event-title">Summer Photo Festival</h3>
                <span class="event-tag">2024</span>
              </div>
              <div class="event-meta">Osaka · Editorial session</div>
            </a>

            <a
              class="event-card"
              href="https://example.com/events/winter-visual-campaign"
              target="_blank"
              rel="noreferrer noopener"
            >
              <div class="event-topline">
                <h3 class="event-title">Winter Visual Campaign</h3>
                <span class="event-tag">2023</span>
              </div>
              <div class="event-meta">Kyoto · Brand ambassador</div>
            </a>
          </div>
        </section>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
      const swiper = new Swiper('.mySwiper', {
        loop: true,
        autoplay: {
          delay: 3500,
          disableOnInteraction: false,
        },
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
        },
        grabCursor: true,
        spaceBetween: 0,
      });
    </script>
  </body>
